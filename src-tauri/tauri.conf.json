{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GeniusBar",
  "version": "0.1.39",
  "identifier": "app.geniusbar",
  "build": {
    "beforeDevCommand": "node scripts/fetch-components.mjs && npm --prefix ui run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/fetch-components.mjs && npm --prefix ui run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GeniusBar",
        "width": 384,
        "height": 560,
        "minWidth": 320,
        "minHeight": 320,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "Your agents, in the menubar.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "resources/components/": "components/",
      "../bridge/bridge.mjs": "bridge/bridge.mjs",
      "../bridge/setup.mjs": "bridge/setup.mjs",
      "../bridge/services.mjs": "bridge/services.mjs",
      "../bridge/cli-tools.mjs": "bridge/cli-tools.mjs",
      "../souls/starter.soul/": "souls/starter.soul/",
      "../souls/geniusbar.soul/": "souls/geniusbar.soul/",
      "../bin/agent-comms": "bin/agent-comms",
      "../bin/agent-bot": "bin/agent-bot",
      "../bin/node": "bin/node"
    },
    "fileAssociations": [
      {
        "ext": ["soul"],
        "name": "GeniusBar Soul Package",
        "role": "Viewer",
        "rank": "Owner",
        "exportedType": {
          "identifier": "app.geniusbar.soul",
          "conformsTo": ["com.apple.package", "public.composite-content"]
        }
      }
    ]
  }
}
